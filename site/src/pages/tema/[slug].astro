---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Feed from '../../components/Feed.astro';
import HeatMap from '../../components/HeatMap.astro';
import Seismogram from '../../components/Seismogram.astro';
import { TEMAS, u } from '../../config';
import { feed, hourAxis, hourlyWorld } from '../../lib/data';
import { temaSummary } from '../../lib/texts';

export function getStaticPaths() {
  return TEMAS.map((t) => ({ params: { slug: t.slug }, props: { tema: t } }));
}
const { tema } = Astro.props;
const axis = hourAxis();
const values = hourlyWorld()[tema.id];
const summary = temaSummary(tema.id);
const items = feed({ tema: tema.id, limit: 50 });
---

<Base title={`${tema.nome} no mundo agora`} description={`${tema.nome}: ${summary.join(' ')}`}>
  <section class="wrap intro">
    <p class="label"><a href={u('/')}>Mapa</a> / Tema</p>
    <h1>{tema.nome} no mundo agora</h1>
    <div class="lede">{summary.map((s) => <p>{s}</p>)}</div>
  </section>

  <section class="wrap">
    <Seismogram
      bands={[{ label: tema.nome, values, total: values.reduce((a, b) => a + b, 0) }]}
      axis={axis}
      caption="Registros por hora nas últimas 72 horas (horário de Brasília)."
    />
  </section>

  <section class="wrap section" aria-labelledby="mapa">
    <div class="section-head"><h2 id="mapa">Onde está acontecendo</h2><span class="label">últimas 24h</span></div>
    <HeatMap tema={tema.id} />
  </section>

  <div class="wrap"><AdSlot slot="tema-1" /></div>

  <section class="wrap section narrow" aria-labelledby="registros">
    <div class="section-head"><h2 id="registros">Registros recentes</h2></div>
    <Feed items={items} />
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: 24px;
  }
  .intro .label a {
    text-decoration: none;
  }
  h1 {
    margin-top: 8px;
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    font-weight: 700;
    font-stretch: 82%;
    letter-spacing: -0.03em;
  }
  .lede {
    margin-top: 14px;
    max-width: 66ch;
    color: var(--bone-dim);
    font-size: 1.05rem;
  }
  .lede p + p {
    margin-top: 0.5em;
  }
  .narrow {
    max-width: 900px;
    margin-left: max(0px, calc((100vw - var(--max)) / 2));
  }
</style>
