---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import Feed from '../components/Feed.astro';
import HeatMap from '../components/HeatMap.astro';
import Seismogram from '../components/Seismogram.astro';
import { SITE_NAME, SITE_URL, TEMAS } from '../config';
import { countries, countryPages, feed, heat, hourAxis, hourlyWorld, newsCount } from '../lib/data';
import { num, pct } from '../lib/format';

const axis = hourAxis();
const world = hourlyWorld();
const bands = TEMAS.map((t) => ({
  label: t.nome,
  href: `/tema/${t.slug}/`,
  values: world[t.id],
  total: world[t.id].reduce((a, b) => a + b, 0),
}));
const h24 = heat('24h');
const per = TEMAS.map((t) => ({ t, n: newsCount(null, t.id, 24) })).sort((a, b) => b.n - a.n);
const lead = per[0];
const rising = h24.subindo
  .slice(0, 6)
  .map((iso) => ({ c: countries()[iso], p: h24.paises[iso] }))
  .filter((r) => r.c);
const pageSet = new Set(countryPages().map((c) => c.iso3));
const items = feed({ limit: 30 });
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: SITE_URL, inLanguage: 'pt-BR' };
---

<Base jsonLd={jsonLd}>
  <section class="wrap intro">
    <h1>O mundo nas últimas 72 horas</h1>
    <p class="lede">
      Nas últimas 24 horas: <strong class="num">{num(per.find((p) => p.t.id === 'conflito')!.n)}</strong> registros de guerras
      e conflitos, <strong class="num">{num(per.find((p) => p.t.id === 'desastre')!.n)}</strong> de desastres,
      <strong class="num">{num(per.find((p) => p.t.id === 'ciber')!.n)}</strong> de ciberataques e
      <strong class="num">{num(per.find((p) => p.t.id === 'energia')!.n)}</strong> de apagões.
      {lead.n > 0 && <>O traço mais forte é o de <a href={`/tema/${lead.t.slug}/`}>{lead.t.nome.toLowerCase()}</a>.</>}
    </p>
  </section>

  <section class="wrap seismo-wrap" aria-label="Sismograma dos temas">
    <Seismogram
      bands={bands}
      axis={axis}
      caption="Cada risco vertical é uma hora. Quanto maior, mais notícias e eventos oficiais registrados naquela hora (horário de Brasília)."
    />
  </section>

  <section class="wrap section" aria-labelledby="mapa">
    <div class="section-head">
      <h2 id="mapa">Mapa de calor</h2>
      <span class="label">toque num país para ver os registros</span>
    </div>
    <HeatMap />
  </section>

  <div class="wrap"><AdSlot slot="home-1" /></div>

  {
    rising.length > 0 && (
      <section class="wrap section" aria-labelledby="subindo">
        <div class="section-head">
          <h2 id="subindo">Subindo agora</h2>
          <span class="label">24h comparadas às 24h anteriores</span>
        </div>
        <ul class="rising">
          {rising.map(({ c, p }) => (
            <li>
              {pageSet.has(c.iso3) ? <a href={`/pais/${c.slug}/`}>{c.nome}</a> : <span>{c.nome}</span>}
              <span class="num amber">{pct(p.variacao)}</span>
              <span class="num small">
                {num(p.anterior)} → {num(p.total)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap section feed-wrap" aria-labelledby="ultimos">
    <div class="section-head">
      <h2 id="ultimos">Últimos registros</h2>
      <a class="label" href="/rss.xml">RSS</a>
    </div>
    <Feed items={items} />
  </section>

  <div class="wrap"><AdSlot slot="home-2" /></div>
</Base>

<style>
  .intro {
    padding-top: clamp(28px, 5vw, 56px);
    padding-bottom: clamp(20px, 3vw, 32px);
  }
  h1 {
    font-size: clamp(2rem, 5.4vw, 4.2rem);
    font-weight: 700;
    font-stretch: 82%;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .lede {
    margin-top: 16px;
    max-width: 62ch;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--bone-dim);
  }
  .lede strong {
    color: var(--bone);
    font-weight: 650;
  }
  .lede a {
    color: var(--amber);
  }
  .rising {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 0 32px;
  }
  .rising li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--graphite);
  }
  .rising li > :first-child {
    font-weight: 600;
    text-decoration: none;
  }
  .rising .amber {
    font-weight: 650;
    text-align: right;
  }
  .rising .small {
    grid-column: 1 / -1;
    font-size: 0.8rem;
    color: var(--ash);
  }
  .feed-wrap {
    max-width: 900px;
    margin-left: max(0px, calc((100vw - var(--max)) / 2));
  }
</style>
