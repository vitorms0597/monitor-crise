---
import { ADSENSE_CLIENT, u } from '../config';
---

{
  ADSENSE_CLIENT && (
    <div class="consent" hidden data-client={ADSENSE_CLIENT}>
      <p>
        Usamos cookies de publicidade para manter o site gratuito. Veja a <a href={u('/privacidade/')}>política de privacidade</a>.
      </p>
      <div class="actions">
        <button type="button" data-choice="no">
          Recusar
        </button>
        <button type="button" data-choice="yes" class="primary">
          Aceitar
        </button>
      </div>
    </div>
  )
}

<script>
  const box = document.querySelector<HTMLElement>('.consent');
  if (box) {
    const KEY = 'mc-consent';
    let choice: string | null = null;
    try {
      choice = localStorage.getItem(KEY);
    } catch {}
    const load = (personalized: boolean) => {
      const w = window as unknown as { adsbygoogle: unknown[] & { requestNonPersonalizedAds?: number } };
      w.adsbygoogle = w.adsbygoogle || [];
      if (!personalized) w.adsbygoogle.requestNonPersonalizedAds = 1;
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${box.dataset.client}`;
      s.crossOrigin = 'anonymous';
      document.head.appendChild(s);
      document.querySelectorAll('ins.adsbygoogle').forEach(() => w.adsbygoogle.push({}));
    };
    if (choice) load(choice === 'yes');
    else box.hidden = false;
    box.addEventListener('click', (ev) => {
      const c = (ev.target as HTMLElement).closest('button')?.dataset.choice;
      if (!c) return;
      try {
        localStorage.setItem(KEY, c);
      } catch {}
      box.hidden = true;
      load(c === 'yes');
    });
  }
</script>

<style>
  .consent {
    position: fixed;
    inset: auto 16px 16px 16px;
    max-width: 560px;
    margin-left: auto;
    z-index: 10;
    background: var(--bone);
    color: var(--soot);
    padding: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.6);
    font-size: 0.9rem;
  }
  .consent p {
    flex: 1 1 240px;
  }
  .actions {
    display: flex;
    gap: 8px;
  }
  button {
    font: inherit;
    font-weight: 600;
    padding: 8px 14px;
    min-height: 40px;
    border: 1px solid var(--soot);
    background: transparent;
    color: var(--soot);
    cursor: pointer;
  }
  .primary {
    background: var(--soot);
    color: var(--bone);
  }
</style>
